
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tienda Running</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Times New Roman', Times, serif; background: #fff; }

        header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding: 30px 80px; 
        }
      .logo { height: 120px; }
      .carrito { position: relative; cursor: pointer; }
      .carrito img { height: 40px; }
      .burbuja { 
            position: absolute; top: -5px; right: -5px; 
            background: red; color: white; border-radius: 50%; 
            width: 20px; height: 20px; font-size: 14px; 
            text-align: center; line-height: 20px; font-weight: bold;
        }

      .form-container { 
            max-width: 1200px; margin: 20px auto; padding: 20px; 
            background: #f9f9f9; border-radius: 8px; border: 1px solid #ddd;
        }
      .form-container h2 { margin-bottom: 15px; text-align: center; }
        #form-producto { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        #form-producto input { padding: 8px; border: 1px solid #ccc; }
        #form-producto button { 
            grid-column: span 4; background: #000; color: white; 
            border: none; padding: 10px; cursor: pointer; font-size: 16px;
        }

        #listado-productos { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 50px; 
            padding: 60px 80px; 
            max-width: 1400px; 
            margin: auto; 
        }
      .card { text-align: center; }
      .card img { 
            width: 100%; 
            height: 300px; 
            object-fit: contain; 
            margin-bottom: 15px; 
        }
      .card h3 { 
            font-size: 18px; 
            font-weight: normal; 
            margin-bottom: 5px; 
        }
      .precio { 
            font-size: 18px; 
            font-weight: bold; 
            margin-bottom: 10px;
        }
      .btn-agregar {
            background: #000; color: white; border: none;
            padding: 8px 20px; cursor: pointer; margin: 5px;
        }
      .btn-eliminar {
            background: #c0392b; color: white; border: none;
            padding: 8px 20px; cursor: pointer; margin: 5px;
        }

        /* MODAL CARRITO */
        #modal-carrito {
            display:none; position:fixed; top:50%; left:50%; 
            transform:translate(-50%,-50%); background:white; 
            padding:30px; border-radius:10px; box-shadow:0 0 20px rgba(0,0,0,0.3); 
            z-index:999; width: 450px;
        }
        #modal-carrito h2 { text-align:center; margin-bottom:20px; }
       .item-carrito { display:flex; align-items:center; gap:10px; margin:10px 0; border-bottom:1px solid #eee; padding-bottom:10px; }
       .item-carrito img { width:50px; height:50px; object-fit:cover; }
       .item-carrito button { padding:2px 8px; }
        #total { font-weight:bold; text-align:center; font-size:20px; margin:15px 0; }
        #btn-finalizar { width:100%; background:#00aaff; color:white; border:none; padding:12px; font-size:16px; cursor:pointer; }
    </style>
</head>
<body>
    <header>
        <img src="/img/logoprincipal.png" alt="Logo Tienda Running" class="logo">
        <div class="carrito">
            <img src="https://cdn-icons-png.flaticon.com/512/263/263142.png" alt="carrito">
            <span class="burbuja">0</span>
        </div>
    </header>

    <main>
        <section class="form-container">
            <h2>Panel Admin - Agregar Producto</h2>
            <form id="form-producto">
                <input type="text" name="title" placeholder="Nombre: Remera" required>
                <input type="number" name="price" placeholder="Precio: 28500" required>
                <input type="url" name="thumbnails" placeholder="URL Imagen" required>
                <input type="text" name="code" placeholder="Código" required>
                <input type="number" name="stock" placeholder="Stock" required>
                <input type="text" name="category" placeholder="Categoría" required>
                <input type="text" name="description" placeholder="Descripción">
                <button type="submit">Agregar Producto</button>
            </form>
        </section>

        <div id="listado-productos">
            {{#each products}}
            <div class="card" id="prod-{{this._id}}">
                <img src="{{this.thumbnails.[0]}}" alt="{{this.title}}">
                <h3>{{this.title}}</h3>
                <p class="precio">$ {{this.price}}</p>
                <button class="btn-agregar" onclick="addToCart('{{this._id}}')">Agregar</button>
                <button class="btn-eliminar" onclick="deleteProduct('{{this._id}}')">Eliminar</button>
            </div>
            {{/each}}
        </div>

        <div id="modal-carrito">
            <h2>Tu compra 😊 🛒 <span onclick="document.getElementById('modal-carrito').style.display='none'" style="cursor:pointer; float:right;">X</span></h2>
            <div id="contenedor-carrito"></div>
            <p id="total"></p>
            <button id="btn-finalizar">FINALIZAR COMPRA</button>
        </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/realTime.js"></script>
</body>
</html>