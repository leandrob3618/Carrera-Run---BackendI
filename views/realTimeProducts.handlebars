
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Tienda Running</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            background: #fff;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 80px;
        }

        .logo {
            height: 120px;
        }

        .carrito {
            position: relative;
            cursor: pointer;
        }

        .carrito img {
            height: 40px;
        }

        .burbuja {
            position: absolute;
            top: -5px;
            right: -5px;
            background: red;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 14px;
            text-align: center;
            line-height: 20px;
            font-weight: bold;
        }

        .form-container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background: #f9f9f9;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .form-container h2 {
            margin-bottom: 15px;
            text-align: center;
        }

        #form-producto {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        #form-producto input {
            padding: 8px;
            border: 1px solid #ccc;
        }

        #form-producto button {
            grid-column: span 4;
            background: #000;
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            font-size: 16px;
        }

        #listado-productos {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 50px;
            padding: 60px 80px;
            max-width: 1400px;
            margin: auto;
        }

        .card {
            text-align: center;
        }

        .card img {
            width: 100%;
            height: 300px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        .card h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 5px;
        }

        .precio {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .btn-agregar {
            background: #000;
            color: white;
            border: none;
            padding: 8px 20px;
            cursor: pointer;
            margin: 5px;
        }

        .btn-eliminar {
            background: #c0392b;
            color: white;
            border: none;
            padding: 8px 20px;
            cursor: pointer;
            margin: 5px;
         }   


        /* MODAL CARRITO */
        #modal-carrito {
            display:none; 
            position:fixed; 
            top:50%; 
            left:50%; 
            transform:translate(-50%,-50%); 
            background:white; 
            padding:30px 40px; 
            border-radius:10px; 
            box-shadow:0 0 20px rgba(0,0,0,0.3); 
            z-index:999; 
            width: 550px;
            font-family: 'Times New Roman', serif;
        }
        #modal-carrito h2 { 
            text-align:center; 
            margin-bottom:20px; 
            font-size: 24px;
            position: relative;
        }
        .btn-cerrar-modal {
            position: absolute;
            right: 0;
            top: 0;
            color: #e74c3c;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            line-height: 20px;
        }
        .item-carrito { 
            display:flex; 
            align-items:center; 
            gap:15px; 
            margin:15px 0; 
            border-bottom:1px solid #eee; 
            padding-bottom:15px; 
        }
        .item-carrito img { 
            width:60px; 
            height:60px; 
            object-fit:contain; 
        }
        .item-carrito .info { flex-grow: 1; }
        .item-carrito .nombre { font-weight: bold; font-size: 16px; }
        .item-carrito .controles { 
            display: flex; 
            align-items: center; 
            gap: 10px;
        }
        .item-carrito .controles button {
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            width: 25px;
            height: 25px;
            line-height: 23px;
            padding: 0;
        }
        .item-carrito .precio { 
            font-weight: bold; 
            font-size: 18px;
            min-width: 100px;
            text-align: right;
        }
        .item-carrito .btn-borrar {
            color: #e74c3c;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
        }
        #total { 
            font-weight:bold; 
            text-align:center; 
            font-size:20px; 
            margin:25px 0 15px 0; 
        }
        #btn-finalizar { 
            width:100%; 
            background:#00aaff; 
            color:white; 
            border:none; 
            padding:12px; 
            font-size:16px; 
            cursor:pointer; 
            border-radius: 5px;
            font-weight: bold;
            font-family: 'Times New Roman', serif;
        }

        #modal-carrito::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: -1;
}
    </style>
</head>

<body>
    <header>
        <img src="/img/logoprincipal.png" alt="Logo Tienda Running" class="logo">
        <div class="carrito">
            <img src="https://cdn-icons-png.flaticon.com/512/263/263142.png" alt="carrito">
            <span class="burbuja">0</span>
        </div>
    </header>

    <main>
        <section class="form-container">
            <h2>Panel Inicial - Altas deProductos</h2>
            <form id="form-producto">
                <input type="text" name="title" placeholder="Nombre: Remera" required>
                <input type="number" name="price" placeholder="Precio: 28500" required>
                <input type="url" name="thumbnails" placeholder="URL Imagen" required>
                <input type="text" name="code" placeholder="Código" required>
                <input type="number" name="stock" placeholder="Stock" required>
                <input type="text" name="category" placeholder="Categoría" required>
                <input type="text" name="description" placeholder="Descripción">
                <button type="submit">Agregar Producto</button>
            </form>
        </section>

        <div id="listado-productos">
            {{#each products}}
            <div class="card" id="prod-{{this._id}}">
                <img src="{{this.thumbnails.[0]}}" alt="{{this.title}}">
                <h3>{{this.title}}</h3>
                <p class="precio">$ {{this.price}}</p>
                <button class="btn-agregar" onclick="addToCart('{{this._id}}')">Agregar</button>
                <button class="btn-eliminar" onclick="deleteProduct('{{this._id}}')">Eliminar</button>
            </div>
            {{/each}}
        </div>

     <div id="modal-carrito">
    <h2>Tu compra 😊 🛒 <span class="btn-cerrar-modal" onclick="document.getElementById('modal-carrito').style.display='none'">×</span></h2>
    <div id="contenedor-carrito"></div>
    <p id="total"></p>
    <button id="btn-finalizar">FINALIZAR COMPRA</button>
</div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/realTime.js"></script>
</body>

</html>